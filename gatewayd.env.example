# Copy to /etc/mcmesh/gatewayd.env (mode 0600). Every line is optional; see `gatewayd` usage for the full list.

# Where the HTTP API listens. Behind a reverse proxy keep it on loopback.
MCMESH_ADDR=127.0.0.1:8080

# Logins: mojang, key or both.
MCMESH_AUTH=mojang,key

# Refuse to start on a missing or empty data directory instead of creating a fresh empty gateway.
# Leave this off for the very first start, then switch it on.
#MCMESH_STRICT_DATA=1

# Scheduled scrub plus incremental backup into this directory (first run after 10 minutes, then daily).
#MCMESH_BACKUP_DIR=/var/backups/mcmesh

# Relay: needs the world it serves, or MCMESH_RELAY=all for every world.
#MCMESH_RELAY=all
#MCMESH_RELAY_ADDR=127.0.0.1:9000
#MCMESH_PUBLIC_ADDR=0.0.0.0:25565
#MCMESH_VOICE_ADDR=0.0.0.0:24454
#MCMESH_ADVERTISE=play.example.org:25565

# Behind a forwarder the real client address is lost, which makes all players share one rate-limit budget.
# HTTP behind a proxy that overwrites X-Forwarded-For:
#MCMESH_TRUST_PROXY=1
# Relay TCP ports behind nginx stream (proxy_protocol on) or haproxy (send-proxy-v2); only when they are reachable through it alone:
#MCMESH_PROXY_PROTOCOL=1
# UDP voice carries no address header, so loosen its limits when it is forwarded:
#MCMESH_RELAY_RATE_SCALE=10

# Operations
#MCMESH_ADMINS=uuid,uuid
#MCMESH_METRICS_TOKEN=change-me
#MCMESH_WEBHOOKS=https://example.org/hook
#MCMESH_WEBHOOK_SECRET=change-me
# Turn on only when every host runs a mod that signs commits.
#MCMESH_REQUIRE_SIGNED=1
